+@contextmanager
+def _dsv41_shard_decode_rows(group, topk, candidates):
+    """Shard whole flattened query rows after their projections and packing."""
+    rows, topk_width = topk.shape
+    if group is None or rows < 4:
+        yield slice(0, rows), topk, candidates
+        return
+
+    world = group.world_size
+    rows_per_rank = (rows + world - 1) // world
+    first = min(group.rank_in_group * rows_per_rank, rows)
+    last = min(first + rows_per_rank, rows)
+    count = last - first
+    candidate_width = candidates.shape[1] if candidates is not None else 0
+    local_topk_elements = rows_per_rank * topk_width
+    local = topk.new_full((rows_per_rank * (topk_width + candidate_width),), -1)
+    local_topk = local[:local_topk_elements].view(rows_per_rank, topk_width)
+    local_candidates = None
+    if candidates is not None:
+        local_candidates = local[local_topk_elements:].view(rows_per_rank, candidate_width)
+        local_candidates = local_candidates[:count]
+    yield slice(first, last), local_topk[:count], local_candidates
+
+    gathered = group.all_gather(local, dim=0).view(world, -1)
+    topk.copy_(gathered[:, :local_topk_elements].reshape(-1, topk_width)[:rows])
+    if candidates is not None:
+        candidate_rows = gathered[:, local_topk_elements:].reshape(-1, candidate_width)
+        candidates.copy_(candidate_rows[:rows])
+
