+@contextmanager
+def _dsv41_shard_prefill_rows(topk, candidates, candidate_write, width):
+    rows, topk_width = topk.shape
+    shards = envs.VLLM_DSV41_PREFILL_INDEXER_TP
+    group = get_dsv41_prefill_indexer_group(shards)
+    if group is None or rows < 128 or width < 8192:
+        yield 0, rows, topk, candidates
+        return
+
+    logger.info_once("V4.1 prefill indexer sharding active (TP%d)", shards)
+    rows_per_rank = (rows + shards - 1) // shards
+    first = min(group.rank_in_group * rows_per_rank, rows)
+    last = min(first + rows_per_rank, rows)
+    candidate_width = candidates.shape[1] if candidate_write else 0
+    local = topk.new_full((rows_per_rank * (topk_width + candidate_width),), -1)
+    topk_elements = rows_per_rank * topk_width
+    local_topk = local[:topk_elements].view(rows_per_rank, topk_width)[: last - first]
+    if candidate_write:
+        local_candidates = local[topk_elements:].view(rows_per_rank, candidate_width)[
+            : last - first
+        ]
+    else:
+        local_candidates = candidates[first:last] if candidates is not None else None
+    yield first, last, local_topk, local_candidates
+
+    gathered = group.all_gather(local, dim=0).view(shards, -1)
+    topk.copy_(gathered[:, :topk_elements].reshape(-1, topk_width)[:rows])
+    if candidate_write:
+        candidates.copy_(
+            gathered[:, topk_elements:].reshape(-1, candidate_width)[:rows]
+        )
+
