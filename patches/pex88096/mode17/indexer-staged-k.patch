+@triton.jit
+def _stage_logical_k(
+    cache, table, decoded, live, width, cache_stride,
+    PAGE: tl.constexpr, NUM_PAGES: tl.constexpr, BLOCK: tl.constexpr,
+):
+    tokens = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    dims = tl.arange(0, _INDEX_HEAD_DIM)
+    physical = tl.load(
+        table + tokens // PAGE, mask=tokens < width, other=-1
+    ).to(tl.int64)
+    offset = tokens % PAGE
+    valid = (tokens < width) & (physical >= 0) & (physical < NUM_PAGES)
+    base = physical[:, None] * cache_stride
+    bits = tl.load(
+        cache + base + offset[:, None] * 64 + dims[None, :] // 2,
+        mask=valid[:, None],
+        other=0,
+    )
+    scales = tl.load(
+        cache + base + PAGE * 64 + offset[:, None] * 4 + dims[None, :] // 32,
+        mask=valid[:, None],
+        other=127,
+    )
+    nibbles = tl.where((dims[None, :] & 1) == 0, bits & 15, bits >> 4)
+    data = _decode_e2m1(nibbles) * tl.exp2(scales.to(tl.float32) - 127.0)
+    tl.store(
+        decoded + tokens[:, None] * _INDEX_HEAD_DIM + dims[None, :],
+        data.to(tl.bfloat16),
+        mask=(tokens < width)[:, None],
+    )
+    tl.store(live + tokens, valid, mask=tokens < width)
+
+
