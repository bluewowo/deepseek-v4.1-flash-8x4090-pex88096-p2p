+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Decode one request's visible MXFP4 indexer keys in logical token order."""
+    page = cache.shape[1]
+    assert table.shape[0] == 1 and (width + page - 1) // page <= table.shape[1]
+    dense = torch.empty(
+        (width, INDEX_HEAD_DIM), dtype=torch.bfloat16, device=cache.device
+    )
+    live = torch.empty(width, dtype=torch.bool, device=cache.device)
+    _stage_logical_k[(triton.cdiv(width, 16),)](
+        cache,
+        table,
+        dense,
+        live,
+        width,
+        cache.stride(0),
+        PAGE=page,
+        NUM_PAGES=cache.shape[0],
+        BLOCK=16,
+        num_warps=4,
+    )
+    return dense, live
