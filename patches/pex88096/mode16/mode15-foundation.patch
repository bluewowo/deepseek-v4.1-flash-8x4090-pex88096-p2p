+from vllm.forward_context import get_forward_context
+from vllm.logger import init_logger
+from vllm.model_executor.kernels.linear.mxfp8.ada import (
+    AdaMxfp8LinearKernel,
+    _ada_mxfp8_k32_linear_kernel,
+)
+from vllm.triton_utils import tl, triton
+from vllm.utils.torch_utils import direct_register_custom_op
+
+ROWS = 8192
+WORLD = 8
+LOCAL = ROWS // WORLD
+INPUTS = 1024
+HIDDEN = 5120
+SCALES = INPUTS // 32
+VALUE_BYTES = LOCAL * INPUTS
+SPLITS = [1] * WORLD
+logger = init_logger(__name__)
+
+
+@triton.jit
+def _sum_parts(parts, out, size: tl.constexpr):
+    elements = tl.program_id(0) * 512 + tl.arange(0, 512)
+    ranks = tl.arange(0, 8)
+    values = tl.load(parts + ranks[:, None] * size + elements[None, :]).to(tl.float32)
+    tl.store(out + elements, tl.sum(values, axis=0))
+
+
+class _Workspace:
+    def __init__(self, comm, device, switch_file):
+        self.comm = comm
+        self.switch_file = switch_file
+        self.send = torch.empty(
+            (WORLD, VALUE_BYTES + LOCAL * SCALES), dtype=torch.uint8, device=device,
+        )
+        self.recv = torch.empty_like(self.send)
+        self.parts = torch.empty((WORLD, LOCAL, HIDDEN), dtype=torch.bfloat16, device=device)
+        self.local_result = torch.empty_like(self.parts[0])
+
+    def project(self, layer, z, *, local_only=False):
+        q, scales, _, _ = AdaMxfp8LinearKernel._quantize_input(z, INPUTS)
+        self.send[:, :VALUE_BYTES].copy_(q.view(torch.uint8).view(WORLD, -1))
+        self.send[:, VALUE_BYTES:].copy_(scales.view(WORLD, -1))
+        self.comm.all_to_all_single(self.recv, self.send, SPLITS, SPLITS)
+        for peer in range(WORLD):
+            data = self.send if peer == self.comm.rank else self.recv
+            x = data[peer, :VALUE_BYTES].view(torch.float8_e4m3fn).view(LOCAL, INPUTS)
+            scale = data[peer, VALUE_BYTES:].view(LOCAL, SCALES)
+            weight, weight_scale = layer._ada_wo_exchange_weights[peer]
+            out = self.parts[peer]
+            _ada_mxfp8_k32_linear_kernel[(640, 1)](
+                x, weight, scale, weight_scale, out, out, LOCAL,
+                N=HIDDEN, K=INPUTS, HAS_BIAS=False, SPLIT_K=1,
+                BLOCK_M=128, BLOCK_N=64, num_warps=4,
+            )
+        _sum_parts[(LOCAL * HIDDEN // 512,)](
+            self.parts, self.local_result, LOCAL * HIDDEN,
+        )
+        if local_only:
+            return self.local_result
+        result = z.new_empty((ROWS, HIDDEN))
+        self.comm.all_gather(result, self.local_result)
+        return result
+
+
+def bind_ada_wo_exchange(layers, limit, *, skip_engram=False):
+    """Replicate the configured weights and allocate measured persistent buffers."""
+    if not 1 <= limit <= len(layers):
+        raise ValueError("Invalid number of encoder layers for Ada WO exchange")
+    group = get_tp_group()
+    comm = getattr(group.device_communicator, "pynccl_comm", None)
+    if group.world_size != WORLD or comm is None or not comm.available or comm.disabled:
+        raise RuntimeError("Ada WO exchange requires the TP8 PyNCCL communicator")
+    switch = os.environ.get("DS1017_WO_EXCHANGE_SWITCH")
+    workspace = None
+    blocks = [block for block in layers[:limit] if not (skip_engram and block.engram is not None)]
+    for block in blocks:
+        attn = block.attn
+        wo = attn.wo_b
+        if (
+            block.use_sequence_parallel
+            or not wo.reduce_results or wo.bias is not None or wo.return_bias
+            or tuple(wo.weight.shape) != (INPUTS, HIDDEN)
+            or tuple(wo.weight_scale.shape) != (HIDDEN, SCALES)
+            or wo.weight.dtype != torch.float8_e4m3fn
+            or wo.weight_scale.dtype != torch.uint8
+            or torch.cuda.get_device_capability(wo.weight.device) != (8, 9)
+        ):
+            raise RuntimeError(f"Unsupported Ada WO topology or weights for {attn.prefix}")
+        w = wo.weight.new_empty((WORLD, INPUTS, HIDDEN))
+        s = wo.weight_scale.new_empty((WORLD, HIDDEN, SCALES))
+        comm.all_gather(w.view(torch.uint8), wo.weight.view(torch.uint8))
+        comm.all_gather(s, wo.weight_scale)
+        attn._ada_wo_exchange_weights = tuple(
+            (wo.weight, wo.weight_scale)
+            if peer == comm.rank else (w[peer].clone(), s[peer].clone())
+            for peer in range(WORLD)
+        )
+        if workspace is None:
+            workspace = _Workspace(comm, wo.weight.device, Path(switch) if switch else None)
+        attn._ada_wo_exchange = workspace
+    logger.info("Ada WO exchange bound for %d encoder layers, rows=%d", len(blocks), ROWS)
+
+
+def _exchange(z: torch.Tensor, prefix: str) -> torch.Tensor:
+    ctx = get_forward_context()
+    layer = ctx.no_compile_layers[prefix]
+    workspace = layer._ada_wo_exchange
+    metadata = ctx.attn_metadata
+    if not isinstance(metadata, dict):
+        return layer.wo_b(z)
+    swa = metadata.get(layer.swa_cache_layer.prefix)
+    if swa is None or swa.num_prefills == 0 or swa.num_decodes != 0:
+        return layer.wo_b(z)
+    if workspace.switch_file is not None:
+        # The lab runner changes this shared file atomically between requests.
+        if layer.layer_id >= int(workspace.switch_file.read_text()):
+            return layer.wo_b(z)
+    logger.info_once("Ada WO exchange executed for %s", prefix)
+    return workspace.project(layer, z)
+
+
+def _exchange_fake(z: torch.Tensor, prefix: str) -> torch.Tensor:
+    return z.new_empty((z.shape[0], HIDDEN))
+
+
+direct_register_custom_op(
+    op_name="dsv41_ada_wo_exchange", op_func=_exchange, fake_impl=_exchange_fake,
+)
