+# SPDX-License-Identifier: Apache-2.0
+"""SM89 experimental sequence-parallel FFN input gather for 1017."""
+import os
+from pathlib import Path
+
+import torch
+
+from vllm.distributed import get_tp_group
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fusion.quant_activation import (
+    QuantizedActivation, get_input_quant_key,
+)
+from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (
+    mxfp8_e4m3_quantize, mxfp8_quantize_dequantize,
+)
+from vllm.model_executor.layers.quantization.utils.quant_utils import kMxfp8Dynamic
+from vllm.triton_utils import tl, triton
+
+logger = init_logger(__name__)
+SWITCH = os.getenv("DS1017_ADA_FFN_GATHER_SWITCH")
+LOCAL_ROWS = 1024
+ROWS = LOCAL_ROWS * 8
+HIDDEN = 5120
+SCALES = HIDDEN // 32
+ROUTES = 6
+ACTIVATION_BYTES = HIDDEN + SCALES
+PACKET_BYTES = ACTIVATION_BYTES + 2 * ROUTES * 4
+
+
+@triton.jit
+def _unpack(packet, q, scales, bf, H: tl.constexpr, P: tl.constexpr):
+    rows = tl.program_id(0) * 16 + tl.arange(0, 16)
+    groups = tl.program_id(1) * 8 + tl.arange(0, 8)
+    cols = groups[:, None] * 32 + tl.arange(0, 32)[None, :]
+    bits = tl.load(packet + rows[:, None, None] * P + cols[None, :, :])
+    exp = tl.load(packet + rows[:, None] * P + H + groups[None, :])
+    decoded = bits.to(tl.float8e4nv, bitcast=True).to(tl.float32)
+    scale = tl.exp2(exp.to(tl.float32) - 127.0)
+    bf16 = (decoded * scale[:, :, None]).to(tl.bfloat16)
+    offset = rows[:, None, None] * H + cols[None, :, :]
+    tl.store(q + offset, bits)
+    tl.store(scales + rows[:, None] * (H // 32) + groups[None, :], exp)
+    tl.store(bf + offset, bf16)
+
+
+def _route(runner, x, token_ids, rank, gate_rows):
+    if gate_rows != LOCAL_ROWS:
+        # For an 8192-row gate, retain the original tile coordinates while
+        # sourcing the rank's activation rows only from its local shard.
+        start = rank * LOCAL_ROWS % gate_rows
+        gate_input = torch.zeros((gate_rows, HIDDEN), dtype=x.dtype, device=x.device)
+        gate_input.narrow(0, start, LOCAL_ROWS).copy_(x)
+        logits, _ = runner.gate(gate_input)
+        logits = logits.narrow(0, start, LOCAL_ROWS)
+    else:
+        logits, _ = runner.gate(x)
+    return runner.router.select_experts(
+        hidden_states=x, router_logits=logits,
+        topk_indices_dtype=runner._quant_method.topk_indices_dtype,
+        input_ids=token_ids,
+    )
+
+
+def _bits_equal(a, b):
+    return torch.equal(a.contiguous().view(torch.uint8), b.contiguous().view(torch.uint8))
+
+
+def _bf16_diff(a, b):
+    if _bits_equal(a, b):
+        return 0, 0.0
+    changed = int((a.view(torch.int16) != b.view(torch.int16)).count_nonzero().item())
+    max_diff = float((a - b).abs().amax().item())
+    return changed, max_diff
+
+
+def maybe_narrow_ffn(ffn, x, token_ids, sp_all_gather):
+    if not SWITCH:
+        return None
+    mode = Path(SWITCH).read_text().strip()
+    if mode == "base":
+        return None
+    if mode not in ("audit", "audit-padded", "audit-padded-trace", "narrow", "narrow-padded"):
+        raise ValueError(f"Unknown 1017 FFN gather mode {mode}")
+    assert x.shape == (LOCAL_ROWS, HIDDEN) and x.dtype == torch.bfloat16
+    assert token_ids is not None and token_ids.shape == (ROWS,)
+    tp = get_tp_group()
+    runner = ffn.experts
+    cfg = runner.moe_config
+    # The model TP communicator has eight ranks. Inside EP, each expert
+    # occupies a single GPU, so the expert module's own TP size is one.
+    assert tp.world_size == cfg.ep_size == 8 and cfg.tp_size == 1
+    assert cfg.moe_parallel_config.ep_rank == tp.rank_in_group
+    assert cfg.dp_size == cfg.pcp_size == 1 and not cfg.is_sequence_parallel
+    assert not runner.do_naive_dispatch_combine and not runner._fse_fuse_gate
+    assert not runner._fused_output_is_reduced and runner.routed_output_transform is None
+    assert runner.gate is not None and runner._shared_experts is not None
+    shared_expert = runner._shared_experts._layer
+    assert get_input_quant_key(shared_expert.gate_up_proj) == kMxfp8Dynamic
+    runner.routed_experts._ensure_moe_quant_config_init()
+    rank = tp.rank_in_group
+    local_ids = token_ids.narrow(0, rank * LOCAL_ROWS, LOCAL_ROWS)
+    weights, ids = _route(runner, x, local_ids, rank, ROWS if "padded" in mode else LOCAL_ROWS)
+    assert weights.dtype == torch.float32 and ids.dtype == torch.int32
+    assert weights.shape == ids.shape == (LOCAL_ROWS, ROUTES)
+    q, scale = mxfp8_e4m3_quantize(x, min_amax=1e-4)
+    local_packet = torch.cat(
+        (q.view(torch.uint8), scale, weights.contiguous().view(torch.uint8),
+         ids.contiguous().view(torch.uint8)), dim=1,
+    )
+    assert local_packet.shape[1] == PACKET_BYTES
+    packet = sp_all_gather(local_packet)
+    q_bytes = torch.empty((ROWS, HIDDEN), device=x.device, dtype=torch.uint8)
+    scales = torch.empty((ROWS, SCALES), device=x.device, dtype=torch.uint8)
+    bf = torch.empty((ROWS, HIDDEN), device=x.device, dtype=torch.bfloat16)
+    _unpack[(ROWS // 16, SCALES // 8)](packet, q_bytes, scales, bf, HIDDEN, PACKET_BYTES)
+    route_ids_byte = ACTIVATION_BYTES + 4 * ROUTES
+    weights = packet[:, ACTIVATION_BYTES:route_ids_byte].contiguous().view(torch.float32)
+    ids = packet[:, route_ids_byte:].contiguous().view(torch.int32)
+    del packet, local_packet
+    audit = mode.startswith("audit")
+    diagnose = mode == "audit-padded-trace"
+    if audit:
+        full = sp_all_gather(x)
+        original = ffn(full, token_ids, ada_prefill_reduce_scatter=2)
+        full_logits, _ = runner.gate(full)
+        ref_weights, ref_ids = runner.router.select_experts(
+            hidden_states=full, router_logits=full_logits,
+            topk_indices_dtype=runner._quant_method.topk_indices_dtype, input_ids=token_ids,
+        )
+        ref_q, ref_scales = mxfp8_e4m3_quantize(full, min_amax=1e-4)
+        id_changes = int((ids != ref_ids).sum().item())
+        weight_changes = int((weights.view(torch.int32) != ref_weights.contiguous().view(torch.int32)).sum().item())
+        quant_equal = _bits_equal(q_bytes, ref_q) and _bits_equal(scales, ref_scales)
+        reconstructed = _bits_equal(bf, mxfp8_quantize_dequantize(full, 1e-4))
+        idempotent = _bits_equal(bf, mxfp8_quantize_dequantize(bf, 1e-4))
+        del full_logits, ref_q, ref_scales
+        if diagnose:
+            ref_local_ids = ref_ids.narrow(0, rank * LOCAL_ROWS, LOCAL_ROWS)
+            ref_local_weights = ref_weights.narrow(0, rank * LOCAL_ROWS, LOCAL_ROWS).view(torch.int32)
+            for gate_rows in (2048, 4096):
+                probe_weights, probe_ids = _route(runner, x, local_ids, rank, gate_rows)
+                logger.info(
+                    "ADA_FFN_GATE_SHAPE_TRACE rows=%d rank=%d layer=%s ids=%d weights=%d",
+                    gate_rows, rank, runner.layer_name,
+                    int((probe_ids != ref_local_ids).count_nonzero().item()),
+                    int((probe_weights.view(torch.int32) != ref_local_weights).count_nonzero().item()),
+                )
+        else:
+            del full, ref_weights, ref_ids
+
+    activation = QuantizedActivation(
+        q_bytes.view(torch.float8_e4m3fn), scales, x.dtype, bf.shape, kMxfp8Dynamic,
+    )
+    shared = shared_expert(activation)
+    routed = runner.routed_experts.forward_modular(x=bf, topk_weights=weights, topk_ids=ids)
+    assert isinstance(routed, torch.Tensor) and isinstance(shared, torch.Tensor)
+    if diagnose:
+        ref_shared = shared_expert(full)
+        shared_delta = _bf16_diff(shared, ref_shared)
+        del ref_shared
+        forward_routed = runner.routed_experts.forward_modular
+        ref_routed = forward_routed(x=full, topk_weights=ref_weights, topk_ids=ref_ids)
+        routed_delta = _bf16_diff(routed, ref_routed)
+        repeated_routed = forward_routed(x=full, topk_weights=ref_weights, topk_ids=ref_ids)
+        repeat_routed_delta = _bf16_diff(ref_routed, repeated_routed)
+        del ref_routed, repeated_routed
+
+    shared, routed = runner._maybe_apply_routed_scale_to_output(shared, routed)
+    result = runner._ada_prefill_reduce_scatter(shared + routed, None, False, check=False)
+    if audit:
+        exact_out = _bits_equal(result, original)
+        if diagnose:
+            del shared, routed, bf, activation, q_bytes, scales
+            repeated = ffn(full, token_ids, ada_prefill_reduce_scatter=2)
+            result_delta = _bf16_diff(result, original)
+            repeat_result_delta = _bf16_diff(repeated, original)
+            logger.info(
+                "ADA_FFN_NARROW_TRACE rank=%d layer=%s shared=%d/%.9g routed=%d/%.9g "
+                "routed_repeat=%d/%.9g out=%d/%.9g out_repeat=%d/%.9g",
+                rank, runner.layer_name, *shared_delta, *routed_delta,
+                *repeat_routed_delta, *result_delta, *repeat_result_delta,
+            )
+        logger.info(
+            "ADA_FFN_NARROW_AUDIT mode=%s rank=%d layer=%s ids=%d weights=%d quant=%d reconstruct=%d requant=%d output=%d",
+            mode, rank, runner.layer_name, id_changes, weight_changes, quant_equal,
+            reconstructed, idempotent, exact_out,
+        )
+        return original
+    logger.info_once("Ada FFN narrow gather executed mode=%s layer=%s", mode, runner.layer_name)
+    return result
