# Copy to .env.pex88096. Paths are resolved from the checkout.
PEX88096_PROFILE=1
VENV="${VENV:-$PROJECT_DIR/.venv-pex88096}"
MODEL_DIR="${MODEL_DIR:-$PROJECT_DIR/models/DeepSeek-V4.1-Flash-1017}"
CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-13.0}"
HOST=127.0.0.1
PORT=8011
SERVED_MODEL_NAME=deepseek-v4.1-flash-1017

# Example topology. Review nvidia-smi topo -m and lspci -tv before using it.
export CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=2,3,4,5,0,1,6,7
# Set the local interface explicitly if eth0 is unavailable.
# GLOO_SOCKET_IFNAME=eth0
# NCCL_SOCKET_IFNAME=eth0
export NCCL_P2P_LEVEL=SYS
export NCCL_P2P_DISABLE=0
export VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC=1

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.96
ENABLE_CED=1
ENABLE_PREFIX_CACHING=1
ENABLE_DSPARK=1
NUM_SPECULATIVE_TOKENS=7
ENABLE_ADAPTIVE_VERIFICATION=1
ENABLE_VISION=1
MAX_IMAGES_PER_PROMPT=2
export VLLM_DSV41_PREFILL_INDEXER_TP=8
export DS1017_DECODE_INDEXER_TP8=1
